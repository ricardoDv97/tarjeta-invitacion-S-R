---
import Layout from '../../layouts/Layout.astro'

const registrationId = Astro.url.searchParams.get('registration') ?? ''
const hasValidReference = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(registrationId)
---

<Layout title="Próximo paso | S & R" description="Continuidad de la confirmación de asistencia.">
  <main class="next-step-page">
    <section class="next-step-card" aria-labelledby="next-step-title">
      <p class="monogram" aria-label="S y R">S <span>&amp;</span> R</p>
      {hasValidReference ? (
        <>
          <p class="eyebrow">Preinscripción guardada</p>
          <h1 id="next-step-title">Gracias por confirmar</h1>
          <p>Tu respuesta inicial quedó registrada. En el próximo paso vas a poder completar los datos de quienes asisten.</p>
          <p class="notice">El registro de invitados estará disponible en el Sprint 07.</p>
          <a href="/">Volver a la invitación</a>
        </>
      ) : (
        <>
          <p class="eyebrow">Referencia no disponible</p>
          <h1 id="next-step-title">No pudimos continuar</h1>
          <p>Volvé al formulario para iniciar una confirmación válida.</p>
          <a href="/confirmar">Volver a confirmar</a>
        </>
      )}
    </section>
  </main>
</Layout>

<style>
  .next-step-page { display: grid; min-height: 100vh; place-items: center; padding: 1.5rem; background: radial-gradient(circle at 15% 20%, rgb(242 166 182 / 25%), transparent 28rem), radial-gradient(circle at 85% 80%, rgb(143 165 138 / 25%), transparent 28rem), var(--wedding-background); }
  .next-step-card { width: min(100%, 42rem); padding: clamp(2.5rem, 8vw, 5rem); border: 1px solid rgb(123 30 58 / 12%); border-radius: var(--radius-soft); background: rgb(255 250 244 / 94%); box-shadow: var(--shadow-soft); text-align: center; }
  .monogram { margin: 0 0 2rem; color: var(--wedding-primary); font: 500 2rem/1 var(--font-display); }
  .monogram span { color: var(--wedding-secondary); font-size: .7em; font-style: italic; }
  .eyebrow { margin: 0 0 .75rem; color: var(--wedding-secondary); font-size: .68rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; }
  h1 { margin: 0; color: var(--wedding-primary); font: 500 clamp(2.7rem, 9vw, 4.5rem)/.95 var(--font-display); }
  p:not(.monogram, .eyebrow) { max-width: 30rem; margin: 1.25rem auto 0; color: var(--wedding-muted); line-height: 1.7; }
  .notice { padding: .8rem 1rem; border-radius: .8rem; background: rgb(143 165 138 / 12%); font-size: .78rem; }
  a { display: inline-flex; min-height: 3rem; align-items: center; justify-content: center; margin-top: 1.75rem; padding: .8rem 1.4rem; border-radius: 999px; color: var(--wedding-surface); background: var(--wedding-primary); font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
</style>
