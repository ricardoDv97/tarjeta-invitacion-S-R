---
import Layout from '../../layouts/Layout.astro'
import { wedding } from '../../config/wedding.js'
const money = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 })
---

<Layout title="Confirmá tu asistencia | Sabri y Ri" description="Confirmación de asistencia a la boda de Ricardo y Sabrina.">
  <main class="page">
    <a class="back" href="/">&larr; Volver a la invitación</a>
    <section class="card" aria-labelledby="title">
      <header><p class="monogram">S <span>&amp;</span> R</p><p class="eyebrow">Queremos celebrar con vos</p><h1 id="title">Confirmá tu asistencia</h1></header>
      <form id="rsvp-form" novalidate>
        <fieldset aria-describedby="attendance-error"><legend>¿Vas a acompañarnos?</legend><div class="choices">
          <label><input type="radio" name="attendance" value="confirmed" required /><span>Sí, voy a asistir</span></label>
          <label><input type="radio" name="attendance" value="cancelled" required /><span>No podré asistir</span></label>
        </div><p class="error" id="attendance-error"></p></fieldset>

        <div id="attending-fields" hidden>
          <fieldset aria-describedby="counts-error"><legend>¿Quiénes van a acompañarnos?</legend>
            <div class="count-list">
              <div class="count-row" data-counter="adultCount"><div><strong>Adultos</strong><small>11 años o más · {money.format(wedding.payment.pricePerGuest)} c/u</small></div><div class="counter"><button type="button" data-change="-1" aria-label="Restar adulto">−</button><output>1</output><button type="button" data-change="1" aria-label="Sumar adulto">+</button></div></div>
              <div class="count-row" data-counter="childCount"><div><strong>Niños</strong><small>6 a 10 años · {money.format(wedding.payment.childPrice)} c/u</small></div><div class="counter"><button type="button" data-change="-1" aria-label="Restar niño">−</button><output>0</output><button type="button" data-change="1" aria-label="Sumar niño">+</button></div></div>
              <div class="count-row" data-counter="youngChildCount"><div><strong>Bebés y niños</strong><small>1 a 5 años · Sin costo</small></div><div class="counter"><button type="button" data-change="-1" aria-label="Restar menor">−</button><output>0</output><button type="button" data-change="1" aria-label="Sumar menor">+</button></div></div>
            </div>
            <div class="summary" aria-live="polite"><p>Total de personas: <strong id="total-people">1</strong></p><p>Total: <strong id="total-amount">{money.format(wedding.payment.pricePerGuest)}</strong></p></div>
            <p class="hint">Podés confirmar entre 1 y 20 personas en total.</p><p class="error" id="counts-error"></p>
          </fieldset>
          <fieldset aria-describedby="payment-error"><legend>¿Cómo preferís realizar la contribución?</legend><div class="choices">
            <label><input type="radio" name="paymentMethod" value="mercadopago" /><span>Mercado Pago</span></label>
            <label><input type="radio" name="paymentMethod" value="cash" /><span>Efectivo</span></label>
          </div><p class="hint">En este paso no se procesará ningún pago.</p><p class="error" id="payment-error"></p></fieldset>
        </div>
        <div class="actions"><button class="submit" id="submit" type="submit"><span data-idle>Continuar</span><span data-loading hidden>Guardando…</span></button><p id="feedback" class="error" role="status"></p></div>
      </form>
      <div id="cancelled" class="success" hidden><h2>Gracias por avisarnos</h2><p>Vamos a extrañarte, pero agradecemos mucho tu respuesta.</p><a href="/">Volver a la invitación</a></div>
    </section>
  </main>
</Layout>

<script define:vars={{ adultPrice: wedding.payment.pricePerGuest, childPrice: wedding.payment.childPrice }}>
  const form = document.querySelector('#rsvp-form')
  const attending = document.querySelector('#attending-fields')
  const submit = document.querySelector('#submit')
  const values = { adultCount: 1, childCount: 0, youngChildCount: 0 }
  let saving = false
  const selected = (name) => form?.querySelector(`input[name="${name}"]:checked`)?.value ?? null
  const error = (id, value = '') => { const node = document.querySelector(`#${id}`); if (node) node.textContent = value }
  const total = () => values.adultCount + values.childCount + values.youngChildCount
  const render = () => {
    document.querySelectorAll('[data-counter]').forEach((row) => {
      const key = row.getAttribute('data-counter'); const output = row.querySelector('output'); if (output && key) output.textContent = String(values[key])
      row.querySelectorAll('button').forEach((button) => { const delta = Number(button.getAttribute('data-change')); button.disabled = (delta < 0 && values[key] <= 0) || (delta > 0 && total() >= 20) })
    })
    document.querySelector('#total-people').textContent = String(total())
    document.querySelector('#total-amount').textContent = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(values.adultCount * adultPrice + values.childCount * childPrice)
  }
  document.querySelectorAll('[data-counter] button').forEach((button) => button.addEventListener('click', () => {
    const key = button.closest('[data-counter]')?.getAttribute('data-counter'); const delta = Number(button.getAttribute('data-change'))
    if (key && Number.isInteger(delta) && values[key] + delta >= 0 && values[key] + delta <= 20 && total() + delta <= 20) { values[key] += delta; render(); error('counts-error') }
  }))
  form?.querySelectorAll('[name="attendance"]').forEach((input) => input.addEventListener('change', () => { attending.hidden = selected('attendance') !== 'confirmed'; error('attendance-error') }))
  const setSaving = (value) => { saving = value; submit.disabled = value; submit.querySelector('[data-idle]').hidden = value; submit.querySelector('[data-loading]').hidden = !value }
  form?.addEventListener('submit', async (event) => {
    event.preventDefault(); if (saving) return
    ;['attendance-error', 'counts-error', 'payment-error', 'feedback'].forEach((id) => error(id))
    const attendance = selected('attendance'); const paymentMethod = selected('paymentMethod'); let valid = true
    if (!attendance) { error('attendance-error', 'Elegí si vas a acompañarnos.'); valid = false }
    if (attendance === 'confirmed' && (total() < 1 || total() > 20)) { error('counts-error', 'El total debe ser entre 1 y 20 personas.'); valid = false }
    if (attendance === 'confirmed' && !['cash', 'mercadopago'].includes(paymentMethod)) { error('payment-error', 'Elegí un método de contribución.'); valid = false }
    if (!valid) return
    setSaving(true)
    try {
      const body = attendance === 'confirmed' ? { attendance, ...values, paymentMethod } : { attendance, paymentMethod: null }
      const response = await fetch('/api/registrations', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
      const result = await response.json().catch(() => null)
      if (!response.ok || !result?.ok) throw new Error(result?.message || 'No pudimos guardar tu respuesta.')
      if (result.nextStep === 'finished') { form.hidden = true; document.querySelector('#cancelled').hidden = false; return }
      if (result.nextStep === 'guests' && typeof result.registrationId === 'string') { window.location.assign(`/confirmar/invitados?registration=${encodeURIComponent(result.registrationId)}`); return }
      throw new Error('La respuesta del servidor no es válida.')
    } catch (cause) { error('feedback', cause instanceof Error ? cause.message : 'Ocurrió un error inesperado.') } finally { setSaving(false) }
  })
  render()
</script>

<style>
  .page{min-height:100vh;padding:clamp(1.25rem,4vw,3rem);background:radial-gradient(circle at 10% 10%,rgb(242 166 182/.25),transparent 30rem),radial-gradient(circle at 90% 90%,rgb(143 165 138/.24),transparent 28rem),var(--wedding-background)}.back{display:inline-block;margin-bottom:1.5rem;color:var(--wedding-primary);font-size:.75rem;font-weight:600;text-decoration:none;text-transform:uppercase}.card{width:min(100%,46rem);margin:auto;padding:clamp(2rem,6vw,4rem);border:1px solid rgb(123 30 58/.12);border-radius:var(--radius-soft);background:rgb(255 250 244/.94);box-shadow:var(--shadow-soft)}header{text-align:center;margin-bottom:2.5rem}.monogram{color:var(--wedding-primary);font:500 2rem/1 var(--font-display)}.monogram span,.eyebrow{color:var(--wedding-secondary)}.eyebrow{font-size:.68rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase}h1,h2,legend{color:var(--wedding-primary);font-family:var(--font-display);font-weight:500}h1{font-size:clamp(2.7rem,9vw,4.8rem);line-height:.95;margin:.5rem 0}fieldset{border:0;margin:0;padding:0 0 2.4rem}legend{width:100%;margin-bottom:1.2rem;font-size:clamp(1.45rem,5vw,2rem);text-align:center}.choices{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.choices label{position:relative;display:flex}.choices input{position:absolute;opacity:0}.choices span{display:flex;width:100%;min-height:4rem;align-items:center;justify-content:center;padding:.8rem;border:1px solid rgb(123 30 58/.24);border-radius:1rem;color:var(--wedding-primary);text-align:center}.choices input:checked+span{color:white;background:var(--wedding-primary)}.choices input:focus-visible+span{outline:3px solid var(--wedding-secondary);outline-offset:3px}.count-list{border-block:1px solid rgb(123 30 58/.14)}.count-row{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid rgb(123 30 58/.1)}.count-row:last-child{border:0}.count-row strong,.count-row small{display:block}.count-row small{margin-top:.2rem;color:var(--wedding-muted)}.counter{display:grid;grid-template-columns:2.5rem 2rem 2.5rem;align-items:center;border:1px solid rgb(123 30 58/.2);border-radius:999px;text-align:center}.counter button{height:2.5rem;border:0;background:transparent;color:var(--wedding-primary);font-size:1.2rem}.counter button:disabled{opacity:.3}.summary{display:flex;justify-content:space-between;gap:1rem;margin-top:1.25rem;padding:1rem;border-radius:1rem;background:rgb(143 165 138/.12)}.summary p{margin:0}.hint,.error{text-align:center;font-size:.75rem}.hint{color:var(--wedding-muted)}.error{color:#982b35}.error:empty{display:none}.actions,.success{text-align:center}.submit,.success a{display:inline-flex;min-width:12rem;min-height:3.2rem;align-items:center;justify-content:center;padding:.8rem 1.5rem;border:0;border-radius:999px;color:white;background:var(--wedding-primary);font-weight:600;text-decoration:none;text-transform:uppercase}.submit:disabled{opacity:.6}.success h2{font-size:2.8rem}.success p{color:var(--wedding-muted)}[hidden]{display:none!important}@media(max-width:36rem){.choices{grid-template-columns:1fr}.card{padding-inline:1.2rem}.count-row{align-items:flex-start}.summary{flex-direction:column}.submit{width:100%}}
</style>
