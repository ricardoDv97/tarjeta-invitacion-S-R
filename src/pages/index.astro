---
import Layout from '../layouts/Layout.astro'
import Footer from '../components/layout/Footer.astro'
import Celebration from '../components/wedding/Celebration.astro'
import Ceremony from '../components/wedding/Ceremony.astro'
import Countdown from '../components/wedding/Countdown.astro'
import DressCode from '../components/wedding/DressCode.astro'
import Gallery from '../components/wedding/Gallery.astro'
import Hero from '../components/wedding/Hero.astro'
import Intro from '../components/wedding/Intro.astro'
import Location from '../components/wedding/Location.astro'
import RSVP from '../components/wedding/RSVP.astro'
import Story from '../components/wedding/Story.astro'
---

<Layout title="S & R — Nuestra Boda" description="Invitación a la boda de S & R.">
  <Intro />
  <main id="invitation-content" tabindex="-1">
    <Hero />
    <Story />
    <Countdown />
    <Ceremony />
    <Celebration />
    <Location />
    <DressCode />
    <Gallery />
    <RSVP />
  </main>
  <Footer />
</Layout>
