---
import Container from '../ui/Container.astro'
import { wedding } from '../../config/wedding.js'
---

<footer class="footer" data-reveal="fade-in">
  <Container>
    <p class="footer__names">{wedding.couple.displayName}</p>
    <p><time datetime={wedding.event.date}>{wedding.event.shortDate}</time></p>
    <small>Gracias por ser parte de nuestra historia.</small>
    <a class="footer__admin" href="/admin/login" aria-label="Acceso administrador">Acceso administrador</a>
  </Container>
</footer>

<style>
  .footer { padding-block: 2rem; background: #5d162c; color: var(--wedding-surface); text-align: center; }
  .footer p { margin: 0; }
  .footer__names { font: 500 2.5rem/1 var(--font-display); }
  .footer p:not(.footer__names) { margin-top: .7rem; color: var(--color-dusty-rose); font-size: .85rem; letter-spacing: .12em; }
  .footer small { display: block; margin-top: 1rem; color: #ecd9d8; font-size: .8rem; line-height: 1.5; }
  .footer__admin { display: flex; align-items: center; min-height: 2.75rem; width: fit-content; margin: .65rem auto 0; color: #d9b8bd; font-size: .72rem; text-decoration: none; }
  .footer__admin:hover { color: #fffaf4; text-decoration: underline; }
</style>
