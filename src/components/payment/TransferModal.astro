---
import { wedding } from '../../config/wedding.js'
const { transfer } = wedding.payment
---
<dialog id="transfer-dialog" aria-labelledby="transfer-title" aria-describedby="transfer-description">
  <div class="dialog-content">
    <button type="button" id="transfer-close" class="close" aria-label="Cerrar transferencia">×</button>
    <p class="eyebrow">Transferencia a Mercado Pago</p>
    <h2 id="transfer-title">Transferencia</h2>
    <p id="transfer-description">Podés realizar la transferencia con los siguientes datos:</p>
    <p class="amount">Total: <strong data-transfer-amount>—</strong></p>
    <dl>
      <div><dt>Entidad</dt><dd><img src="/images/mercado-pago.svg" alt="" width="72" height="30" />{transfer.provider}</dd></div>
      <div><dt>Alias</dt><dd><strong id="transfer-alias">{transfer.alias}</strong></dd></div>
      {transfer.holder && <div><dt>Titular</dt><dd>{transfer.holder}</dd></div>}
    </dl>
    <button type="button" id="copy-alias" class="secondary">Copiar alias</button>
    <p id="copy-status" role="status" aria-live="polite"></p>
    <div id="transfer-question"><h3>¿Ya realizaste el pago?</h3><div class="choices"><button type="button" id="transfer-yes" class="primary">Sí</button><button type="button" id="transfer-no" class="secondary">No</button></div></div>
    <p id="transfer-result" role="status" aria-live="polite" hidden></p>
    <p id="transfer-error" role="alert"></p>
    <a id="transfer-finish" class="primary finish" href="/" hidden>Finalizar</a>
  </div>
</dialog>
<style>
  dialog{width:min(31rem,calc(100% - 2rem));max-height:calc(100dvh - 2rem);margin:auto;padding:0;border:1px solid rgb(123 30 58/.18);border-radius:1.5rem;background:var(--wedding-background);color:var(--wedding-text);box-shadow:var(--shadow-soft);overflow-y:auto}dialog::backdrop{background:rgb(42 28 31/.55);backdrop-filter:blur(3px)}.dialog-content{position:relative;padding:2.5rem 1.5rem 1.5rem;text-align:center}.close{position:absolute;top:.5rem;right:.5rem;width:2.75rem;height:2.75rem;border:0;border-radius:50%;background:transparent;color:var(--wedding-primary);font-size:1.8rem}.eyebrow{color:var(--wedding-secondary);font-size:.65rem;letter-spacing:.14em;text-transform:uppercase}h2{font:500 clamp(2.3rem,8vw,3.4rem)/1.1 var(--font-display);color:var(--wedding-primary);margin:.6rem 0}p{font-size:.95rem;line-height:1.6}.amount{margin:1.25rem 0;color:var(--wedding-primary)}dl{padding:1rem;border:1px solid rgb(123 30 58/.15);border-radius:1rem;text-align:left}dl>div{display:grid;grid-template-columns:5rem minmax(0,1fr);align-items:center;gap:.5rem;padding:.5rem 0}dt{font-size:.8rem;color:var(--wedding-muted)}dd{margin:0;display:flex;gap:.5rem;align-items:center;overflow-wrap:anywhere;min-width:0}dd img{object-fit:contain;flex-shrink:0}h3{font-size:1.05rem;margin:1.5rem 0 1rem}.choices{display:flex;gap:.75rem}.choices button{flex:1}.primary,.secondary{display:inline-flex;align-items:center;justify-content:center;min-height:2.9rem;padding:.75rem 1.2rem;border-radius:999px;font:600 .9rem var(--font-body);cursor:pointer;text-decoration:none}.primary{border:1px solid var(--wedding-primary);background:var(--wedding-primary);color:#fff}.secondary{border:1px solid var(--wedding-primary);background:transparent;color:var(--wedding-primary)}button:disabled{opacity:.6;cursor:wait}button:focus-visible,a:focus-visible{outline:3px solid var(--wedding-secondary);outline-offset:3px}.finish{width:100%;margin-top:1rem}#copy-status{min-height:1.5rem;font-size:.8rem;color:var(--wedding-primary)}#transfer-error{color:#982b35}#transfer-error:empty{display:none}[hidden]{display:none!important}
</style>
