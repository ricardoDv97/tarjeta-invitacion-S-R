---
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
import { wedding } from '../../config/wedding.js'
const { rsvp } = wedding
---

<section id="rsvp" class="rsvp section-space" aria-labelledby="rsvp-title" data-reveal="fade-up">
  <Container size="editorial">
    <div class="rsvp__ornament" aria-hidden="true">S <span>&amp;</span> R</div>
    <p class="rsvp__eyebrow">Queremos celebrar con vos</p>
    <h2 id="rsvp-title">{rsvp.title}</h2>
    <p>{rsvp.description}</p>
    <Button href={rsvp.href} variant="primary">Confirmar asistencia</Button>
    <small>La confirmación estará disponible próximamente.</small>
  </Container>
</section>

<style>
  .rsvp { position: relative; overflow: hidden; background: linear-gradient(145deg, #f6e2e5, var(--color-ivory)); text-align: center; }
  .rsvp__ornament { margin-bottom: 2rem; color: var(--wedding-primary); font: 500 1.8rem/1 var(--font-display); }
  .rsvp__ornament span { color: var(--wedding-secondary); font-size: .7em; font-style: italic; }
  .rsvp__eyebrow { margin: 0 0 .8rem; color: var(--wedding-secondary); font-size: .7rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--wedding-primary); font: 500 clamp(2.8rem, 9vw, 5rem)/.95 var(--font-display); }
  p:not(.rsvp__eyebrow) { margin: 1.25rem auto 2rem; color: var(--wedding-muted); line-height: 1.7; }
  small { display: block; margin-top: 1rem; color: var(--wedding-muted); font-size: .72rem; }
</style>
