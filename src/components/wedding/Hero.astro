---
import Container from '../ui/Container.astro'
import { wedding } from '../../config/wedding.js'
const { heroImage } = wedding.media
---

<section id="hero" class:list={['hero', heroImage && 'hero--with-image']} aria-labelledby="hero-title" data-reveal="fade-in">
  {heroImage && <img class="hero__image" src={heroImage} alt="S y R celebrando su historia" width="1600" height="1000" loading="eager" fetchpriority="high" />}
  <div class="hero__veil" aria-hidden="true"></div>
  <div class="hero__branch hero__branch--left" aria-hidden="true"></div>
  <div class="hero__branch hero__branch--right" aria-hidden="true"></div>
  <Container class="hero__content">
    <p class="hero__eyebrow">{wedding.event.eyebrow}</p>
    <h2 id="hero-title">{wedding.couple.displayName}</h2>
    <p class="hero__title">{wedding.event.title}</p>
    {wedding.event.date && <time datetime={wedding.event.date}>{wedding.event.date}</time>}
    <span class="hero__ornament" aria-hidden="true">✦</span>
    <p class="hero__message">{wedding.event.message}</p>
  </Container>
</section>

<style>
  .hero { position: relative; display: grid; min-height: 100svh; place-items: center; overflow: hidden; isolation: isolate; background: radial-gradient(circle at 50% 42%, #fffaf4 0 15%, transparent 58%), linear-gradient(155deg, var(--color-ivory), #f5e2dc); }
  .hero__image, .hero__veil { position: absolute; z-index: -2; inset: 0; width: 100%; height: 100%; }
  .hero__image { object-fit: cover; }
  .hero__veil { z-index: -1; background: linear-gradient(rgb(36 24 20 / 24%), rgb(71 25 38 / 46%)); }
  .hero:not(.hero--with-image) .hero__veil { display: none; }
  .hero__content { padding-block: clamp(5rem, 14vh, 9rem); text-align: center; }
  .hero__eyebrow { margin: 0 0 1rem; color: var(--wedding-secondary); font-size: .72rem; font-weight: 600; letter-spacing: .3em; text-transform: uppercase; }
  h2 { margin: 0; color: var(--wedding-primary); font: 500 clamp(5.5rem, 24vw, 12rem)/.72 var(--font-display); letter-spacing: -.05em; }
  .hero__title { margin: clamp(1.5rem, 5vw, 2.5rem) 0 0; font: 500 clamp(1.8rem, 6vw, 3rem)/1 var(--font-display); }
  time { display: block; margin-top: 1rem; letter-spacing: .16em; text-transform: uppercase; }
  .hero__ornament { display: block; margin: 1.5rem 0; color: var(--color-mustard); }
  .hero__message { max-width: 34rem; margin: 0 auto; color: var(--wedding-muted); line-height: 1.75; }
  .hero--with-image :is(.hero__eyebrow, h2, .hero__title, time, .hero__message, .hero__ornament) { color: #fffaf4; text-shadow: 0 2px 1.5rem rgb(28 12 17 / 28%); }
  .hero__branch { position: absolute; z-index: -1; width: clamp(9rem, 28vw, 22rem); height: clamp(15rem, 40vw, 28rem); border-left: 2px solid rgb(143 165 138 / 42%); border-radius: 50%; transform: rotate(32deg); }
  .hero__branch::before, .hero__branch::after { position: absolute; width: 5rem; height: 2.1rem; border-radius: 100% 0; background: rgb(143 165 138 / 28%); content: ''; }
  .hero__branch::before { top: 25%; left: -1rem; transform: rotate(35deg); }
  .hero__branch::after { top: 55%; left: -3.8rem; transform: rotate(145deg); }
  .hero__branch--left { bottom: -5rem; left: -3rem; }
  .hero__branch--right { top: -5rem; right: -3rem; transform: rotate(210deg); }
  @media (max-height: 600px) and (orientation: landscape) {
    .hero { min-height: 34rem; }
    .hero__content { padding-block: 3.5rem; }
    h2 { font-size: clamp(4.5rem, 20vh, 7rem); }
    .hero__title { margin-top: 1rem; }
    .hero__ornament { margin-block: .8rem; }
  }
</style>
