---
import { Image } from 'astro:assets'
import Container from '../ui/Container.astro'
import { wedding } from '../../config/wedding.js'
---

<section id="hero" class="hero" aria-labelledby="hero-title">
  <Image class="hero__image" src={wedding.media.heroImage} alt="Sabri y Ri bajo los árboles" widths={[640, 960, 1440, 1920]} width={1920} sizes="(max-width: 640px) 130vh, 100vw" format="webp" quality={80} loading="eager" fetchpriority="high" />
  <div class="hero__veil" aria-hidden="true"></div>
  <Container class="hero__content">
    <h2 id="hero-title">{wedding.couple.displayName}</h2>
    <p>{wedding.event.eyebrow}</p>
    <time datetime={wedding.event.date}>{wedding.event.shortDate}</time>
  </Container>
</section>

<style>
  .hero { position: relative; display: grid; min-height: 85svh; align-items: end; isolation: isolate; overflow: hidden; background: #283527; color: #fffaf4; }
  .hero__image, .hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .hero__image { object-fit: cover; object-position: 50% 48%; }
  .hero__veil { z-index: -1; background: linear-gradient(180deg, transparent 30%, rgb(15 23 17 / 24%) 52%, rgb(15 23 17 / 85%) 100%); }
  .hero :global(.hero__content) { padding-block: 2rem clamp(2.5rem, 6vh, 4rem); text-align: center; text-shadow: 0 2px 18px rgb(0 0 0 / 30%); }
  h2 { margin: 0; font: 500 clamp(3.8rem, 13vw, 8rem)/1 var(--font-display); letter-spacing: -.035em; }
  p { margin: .8rem 0 1rem; font-size: .8rem; letter-spacing: .25em; }
  time { font-size: clamp(.9rem, 2vw, 1.15rem); letter-spacing: .2em; }
  @media (max-width: 40rem) { .hero { min-height: 82svh; } .hero__image { object-position: 51% 45%; } }
</style>
