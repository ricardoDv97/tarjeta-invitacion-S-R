---
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import { wedding } from '../../config/wedding.js'
const { location } = wedding
---

<section id="ubicacion" class="location section-space" aria-labelledby="location-title">
  <Container class="location__layout">
    <div class="location__map" aria-hidden="true"><div class="location__pin"><span></span></div><i></i><i></i><i></i></div>
    <div class="location__copy">
      <SectionHeading eyebrow="Encontranos" title={location.title} description={location.description} align="left" id="location-title" />
      <address>{location.address || 'Ubicación a confirmar'}</address>
      {location.mapUrl ? <Button href={location.mapUrl} external variant="secondary">Cómo llegar <span aria-hidden="true">↗</span></Button> : <Button disabled variant="secondary">Ubicación disponible pronto</Button>}
    </div>
  </Container>
</section>

<style>
  .location { background: var(--wedding-surface); }
  .location__layout { display: grid; gap: 2.75rem; align-items: center; }
  .location__map { position: relative; min-height: 19rem; overflow: hidden; border-radius: var(--radius-soft); background: linear-gradient(30deg, #e8ded5, #e2e8dd); box-shadow: var(--shadow-soft); }
  .location__map::before, .location__map::after, .location__map i { position: absolute; height: 140%; border-left: 1px solid rgb(123 30 58 / 15%); content: ''; transform: rotate(35deg); }
  .location__map::before { left: 20%; top: -20%; } .location__map::after { right: 20%; top: -20%; }
  .location__map i:nth-of-type(1) { top: -20%; left: 50%; transform: rotate(-50deg); }
  .location__map i:nth-of-type(2) { top: 20%; left: 10%; width: 120%; height: auto; border-top: 1px solid rgb(143 165 138 / 38%); transform: rotate(10deg); }
  .location__map i:nth-of-type(3) { top: 70%; left: -10%; width: 120%; height: auto; border-top: 1px solid rgb(143 165 138 / 38%); transform: rotate(-8deg); }
  .location__pin { position: absolute; z-index: 2; top: 50%; left: 50%; display: grid; width: 4rem; aspect-ratio: 1; place-items: center; border-radius: 50% 50% 50% 0; background: var(--wedding-primary); box-shadow: 0 .75rem 1.5rem rgb(123 30 58 / 24%); transform: translate(-50%, -65%) rotate(-45deg); }
  .location__pin span { width: .8rem; aspect-ratio: 1; border-radius: 50%; background: var(--wedding-surface); }
  address { margin: -1rem 0 1.5rem; color: var(--wedding-muted); font-style: normal; line-height: 1.6; }
  @media (min-width: 48rem) { .location__layout { grid-template-columns: 1.05fr .95fr; gap: clamp(4rem, 8vw, 7rem); } }
</style>
