---
import Button from '../ui/Button.astro'
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import { wedding } from '../../config/wedding.js'
const { location } = wedding
---

<section id="ubicacion" class="location section-space" aria-labelledby="location-title" data-reveal="fade-up">
  <Container size="editorial">
    <SectionHeading title={location.title} id="location-title" />
    <p class="location__name">{location.name}</p>
    <p class="location__description">{location.description}</p>
    <Button href={location.mapUrl} external variant="secondary">Ver ubicación en Google Maps <span aria-hidden="true">↗</span></Button>
  </Container>
</section>

<style>
  .location { text-align: center; border-top: 1px solid rgb(123 30 58 / 12%); }
  .location__name { max-width: 34rem; margin: 0 auto; font: 500 clamp(1.5rem, 4vw, 2rem)/1.2 var(--font-display); text-wrap: balance; }
  .location__description { margin: 1rem auto 1.5rem; color: var(--wedding-muted); line-height: 1.6; }
  .location :global(.button) { max-width: 100%; text-transform: none; letter-spacing: .02em; text-align: center; }
</style>
