---
import { Image } from 'astro:assets'
import Container from '../ui/Container.astro'
import SectionHeading from '../ui/SectionHeading.astro'
import { wedding } from '../../config/wedding.js'
---

<section id="galeria" class="gallery section-space" aria-labelledby="gallery-title">
  <Container>
    <SectionHeading title="Nosotros" description="Algunos momentos antes de comenzar un nuevo capítulo." id="gallery-title" />
    <div class="gallery__grid">
      {wedding.media.gallery.map((item) => (
        <figure class="gallery__item" data-reveal="fade-up">
          <Image src={item.src} alt={item.alt} width={960} widths={[320, 480, 720, 960]} sizes="(min-width: 1024px) 30vw, (min-width: 600px) 46vw, 94vw" format="webp" quality={78} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </Container>
</section>

<style>
  .gallery__grid { columns: 1; column-gap: .75rem; }
  .gallery__item { margin: 0 0 .75rem; break-inside: avoid; overflow: hidden; background: #e2ded5; }
  .gallery__item img { display: block; width: 100%; height: auto; }
  @media (min-width: 600px) { .gallery__grid { columns: 2; } }
  @media (min-width: 1024px) { .gallery__grid { columns: 3; } }
</style>
