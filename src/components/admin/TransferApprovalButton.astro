---
const { registrationId } = Astro.props
---
<button type="button" data-transfer-approve data-registration-id={registrationId} class="min-h-11 rounded-lg bg-[#7b1e3a] px-4 py-2 text-xs font-semibold text-white focus-visible:outline-2 focus-visible:outline-offset-2 disabled:opacity-50">Confirmar transferencia recibida</button>
