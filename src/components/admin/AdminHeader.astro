---
const { email } = Astro.props
---
<header class="border-b border-slate-200 bg-white">
  <div class="mx-auto flex max-w-[90rem] flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
    <div><p class="text-xs font-bold uppercase tracking-[.18em] text-[#7b1e3a]">Ricardo & Sabrina</p><h1 class="text-xl font-semibold text-slate-900">Administración</h1></div>
    <nav class="order-3 flex w-full gap-4 overflow-x-auto text-sm font-semibold text-slate-600 md:order-2 md:w-auto" aria-label="Secciones del dashboard">
      <a href="#resumen">Resumen</a><a href="#inscripciones">Inscripciones</a><a href="#invitados">Invitados</a><a href="#pagos">Pagos</a><a href="#efectivo">Efectivo</a>
    </nav>
    <div class="flex items-center gap-3"><span class="hidden max-w-52 truncate text-xs text-slate-500 sm:block">{email}</span><form method="POST" action="/api/admin/logout"><button class="rounded-full border border-slate-300 px-4 py-2 text-sm font-semibold hover:bg-slate-50">Salir</button></form></div>
  </div>
</header>
